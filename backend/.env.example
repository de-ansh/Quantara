# Application
APP_NAME=Quantara
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Encrypts users' stored OpenAI keys; keep it stable so they stay readable when SECRET_KEY rotates.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://quantara:quantara@localhost:5432/quantara
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1

# SEC EDGAR
SEC_USER_AGENT=YourCompanyName admin@example.com

# Slack incoming webhook for price-alert / watchlist-signal notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Sentry error monitoring (optional)
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting (Redis-backed)
LOGIN_RATE_LIMIT_PER_MINUTE=10
RESEARCH_GENERATION_LIMIT_PER_HOUR=20

# Research reports older than this are regenerated on request
RESEARCH_CACHE_MAX_AGE_HOURS=24

# Background Tasks (hourly SEC/market signal pass; one worker runs it via a Postgres lock)
ENABLE_BACKGROUND_TASKS=true
